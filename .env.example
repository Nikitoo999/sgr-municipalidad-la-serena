DJANGO_SECRET_KEY='django-insecure-municipalidad-laserena-sgr-2026-secret-key'
DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1'

# --- Base de datos ----------------------------------------------------------
# Por defecto se usa SQLite: si no defines nada de aqui, la app trabaja con el
# archivo db.sqlite3 del proyecto y no hace falta instalar nada extra.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# MariaDB / MySQL (ejemplo principal para producción EC2):
# descomenta y ajusta estas variables
# (requiere mysqlclient, que esta en requirements.txt).
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sgr_laserena
# DB_USER=sgr_user
# DB_PASSWORD=pone_aqui_tu_contraseña
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Email ----------------------------------------------------------------
# Backend de correo. Por defecto imprime en consola (el código de recuperación
# aparece en la consola del servidor). Para producción usa SMTP real.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración SMTP (solo si usas el backend smtp):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
# EMAIL_USE_TLS=True

# Remitente por defecto para los correos del sistema:
# DEFAULT_FROM_EMAIL=no-reply@sgr.municipalidadla-serena.cl