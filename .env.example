DJANGO_SECRET_KEY='django-insecure-municipalidad-laserena-sgr-2026-secret-key'
DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1'

# --- Base de datos ----------------------------------------------------------
# Por defecto se usa SQLite: si no defines nada de aqui, la app trabaja con el
# archivo db.sqlite3 del proyecto y no hace falta instalar nada extra.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# MariaDB / MySQL (ejemplo principal para producción EC2):
# descomenta y ajusta estas variables
# (requiere mysqlclient, que esta en requirements.txt).
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sgr_laserena
# DB_USER=sgr_user
# DB_PASSWORD=pone_aqui_tu_contraseña
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Recuperación de contraseña / correo --------------------------------------
# En desarrollo el código se imprime en la consola (backend por defecto).
# Para enviar correos reales (AWS SES, Gmail SMTP, etc.):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.test
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=pone_aqui_tu_clave
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@tu-dominio.cl
# PASSWORD_RESET_TTL_SECONDS=600
# PASSWORD_RESET_RESEND_SECONDS=45
# PASSWORD_RESET_MAX_ATTEMPTS=5