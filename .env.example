DJANGO_SECRET_KEY='django-insecure-municipalidad-laserena-sgr-2026-secret-key'
DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1'

# --- Base de datos ----------------------------------------------------------
# Por defecto se usa SQLite: si no defines nada de aqui, la app trabaja con el
# archivo db.sqlite3 del proyecto y no hace falta instalar nada extra.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# MariaDB / MySQL (ejemplo principal para producción EC2):
# descomenta y ajusta estas variables
# (requiere mysqlclient, que esta en requirements.txt).
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=sgr_laserena
# DB_USER=sgr_user
# DB_PASSWORD=pone_aqui_tu_contraseña
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Orígenes de confianza para CSRF (solo si publicas con dominio/HTTPS) ---
# CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA,https://sgr.midominio.cl

# --- Correo (recuperación de contraseña) ------------------------------------
# Sin EMAIL_HOST, el correo solo se imprime en la consola del servidor.
# Para enviarlo de verdad con AWS SES (ver docs/CORREO_AWS_SES.md):
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=credencial_smtp_usuario
# EMAIL_HOST_PASSWORD=credencial_smtp_clave
# DEFAULT_FROM_EMAIL=SGR La Serena <no-reply@tu-dominio-verificado.cl>
