DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1'

# --- Base de datos ----------------------------------------------------------
# Por defecto se usa SQLite: si no defines nada de aqui, la app trabaja con el
# archivo db.sqlite3 del proyecto y no hace falta instalar nada extra.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Solo si usas Postgres o MySQL: descomenta y ajusta estas variables
# (DB_USER, DB_PASSWORD, DB_HOST y DB_PORT no aplican a SQLite).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sgr_municipalidad_laserena
# DB_USER=usuario
# DB_PASSWORD=clave
# DB_HOST=127.0.0.1
# DB_PORT=5432
